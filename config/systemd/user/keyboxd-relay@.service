[Unit]
Description=gpg4win to WSL connector for GPG
Requires=keyboxd-relay.socket

[Service]
Type=simple
ExecStartPre=-%h/.local/bin/gpgconf.exe --launch keyboxd
ExecStart=%h/.local/bin/npiperelay.exe -ep -ei -s -a 'C:/Users/hmorris/AppData/Local/gnupg/S.keyboxd'
StandardInput=socket

[Install]
WantedBy=default.target
