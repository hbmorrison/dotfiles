[Unit]
Description=SSH agent relay for WSL
After=network.target
Requires=ssh-agent-relay.socket

[Service]
Type=forking
ExecStart=%h/.local/bin/ssh-agent-relay start
ExecStop=%h/.local/bin/ssh-agent-relay stop
Restart=on-failure
RestartSec=10
TimeoutStartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
