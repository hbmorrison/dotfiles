[Unit]
Description=GPG Agent Relay for WSL
After=network.target
Requires=gpg-agent.socket

[Service]
Type=forking
ExecStart=%h/.local/bin/gpg-agent-relay start
ExecStop=%h/.local/bin/gpg-agent-relay stop
Restart=on-failure
RestartSec=10
TimeoutStartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
