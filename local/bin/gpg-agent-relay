#!/bin/bash

# Windows directories.

USER_PROFILE_DIR="/mnt/c/Users/${USER}"
APPDATA_LOCAL_DIR="${USER_PROFILE_DIR}/AppData/Local"
PACKAGES_DIR="${APPDATA_LOCAL_DIR}/Microsoft/WinGet/Packages"
GNUPG_DIR="${APPDATA_LOCAL_DIR}/gnupg"

# Get the full path to npiperelay.

NPIPERELAY_DIR=$(find "${PACKAGES_DIR}" -name 'albertony.npiperelay_*' -type d)
NPIPERELAY="${NPIPERELAY_DIR}/npiperelay.exe"

# Define the sockets.

SOCKET="S.gpg-agent"
WSL_SOCKET="${XDG_RUNTIME_DIR/%\/}/gnupg/${SOCKET}"
WINDOWS_SOCKET="${NPIPERELAY} -ep -ei -s -a ${GNUPG_DIR}/${SOCKET}"

# Array containing the socat command and arguments.

SOCAT=(socat "UNIX-LISTEN:${WSL_SOCKET},fork" "EXEC:${WINDOWS_SOCKET},nofork")

# Functions for sending info to stderr.

notice () {
  [ $# -gt 0 ] && echo "$(basename $0) ${1}" 1>&2;
}

usage () {
  echo "Usage: $(basename $0) < status | start | stop | restart | pid>" 1>&2 && exit 1;
}

error () {
  [ $# -gt 0 ] && echo "$(basename $0) ${1}" 1>&2
  [ ${#FUNCNAME[@]} -gt 3 ] && return 1 || exit 1
}

# Make sure that an argument has been given.

[ $# -eq 0 ] && usage

# Functions for managing socat.

handle_status () {
  if PID=$(pgrep --full --exact --uid=${UID} "${SOCAT[*]}" 2>/dev/null)
  then
    notice "is running with pid ${PID}"
  else
    notice "is not running"
    return 1
  fi
}

handle_start () {
  if ! pgrep --full --exact --uid=${UID} "${SOCAT[*]}" &>/dev/null
  then
    (rm -f "${WSL_SOCKET}" &>/dev/null && (setsid "${SOCAT[@]}" &) &>/dev/null)
  else
    error "is already running"
  fi
  if ! pgrep --full --exact --uid=${UID} "${SOCAT[*]}" &>/dev/null
  then
    error "did not start"
  fi
}

handle_stop () {
  if pgrep --full --exact --uid=${UID} "${SOCAT[*]}" &>/dev/null
  then
    pkill --full --exact --uid=${UID} "${SOCAT[*]}" &>/dev/null
  else
    error "is not running"
  fi
}

handle_restart () {
  handle_stop && handle_start
}

handle_systemd () {
  shift;
  [ $# -eq 1 ] && systemctl --user "${1}" "$(basename $0).service" || return 1
}

# Decide what to do.

case "${1}" in
  systemd) handle_systemd "$@" ;;
  status)  handle_status       ;;
  start)   handle_start        ;;
  stop)    handle_stop         ;;
  restart) handle_restart      ;;
  *)       usage               ;;
esac
