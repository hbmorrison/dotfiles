#!/bin/bash

# Location of WSL side files.

SSH_ENV="$HOME/.ssh/agent.env"
SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"

# Location of Windows side files.

USER_PROFILE="/mnt/c/Users/${USER}"
APPDATA_LOCAL="${USER_PROFILE}/AppData/Local"
WINGET_PACKAGES_DIR="${APPDATA_LOCAL}/Microsoft/WinGet/Packages"
NPIPERELAY_DIR=$(find "${WINGET_PACKAGES_DIR}" -name 'albertony.npiperelay_*' -type d)
NPIPERELAY="${NPIPERELAY_DIR}/npiperelay.exe"
WINDOWS_SOCKET="${NPIPERELAY} -ei -s //./pipe/openssh-ssh-agent"

# Array containing the socat command and arguments.

SOCAT=(socat "UNIX-LISTEN:${SSH_AUTH_SOCK},fork" "EXEC:${WINDOWS_SOCKET},nofork")

# Functions for sending info to stderr.

notice () {
  [ $# -gt 0 ] && echo "$(basename $0) ${1}" 1>&2;
}

usage () {
  echo "Usage: $(basename $0) < status | start | stop | restart | pid>" 1>&2 && exit 1;
}

error () {
  [ $# -gt 0 ] && echo "$(basename $0) ${1}" 1>&2
  [ ${#FUNCNAME[@]} -gt 3 ] && return 1 || exit 1
}

# Make sure that an argument has been given.

[ $# -eq 0 ] && usage

# Functions for managing socat.

handle_status () {
  if PID=$(pgrep --full --exact --uid=${UID} "${SOCAT[*]}" 2>/dev/null)
  then
    notice "is running with pid ${PID}"
  else
    notice "is not running"
    rm -f "${AGENT_ENV}" &>/dev/null
    return 1
  fi
}

handle_start () {
  if ! pgrep --full --exact --uid=${UID} "${SOCAT[*]}" &>/dev/null
  then
    (rm -f "${SSH_AUTH_SOCK}" &>/dev/null && (setsid "${SOCAT[@]}" &) &>/dev/null)
  else
    error "is already running"
  fi
  if PID=$(pgrep --full --exact --uid=${UID} "${SOCAT[*]}") 2>/dev/null
  then
    echo "SSH_AUTH_SOCK=${SSH_AUTH_SOCK}" > "${SSH_ENV}"
  else
    error "did not start"
  fi
}

handle_stop () {
  if pgrep --full --exact --uid=${UID} "${SOCAT[*]}" &>/dev/null
  then
    rm -f "${AGENT_ENV}" &>/dev/null
    pkill --full --exact --uid=${UID} "${SOCAT[*]}" &>/dev/null
  else
    error "is not running"
  fi
}

handle_restart () {
  handle_stop && handle_start
}

handle_systemd () {
  [ $# -eq 1 ] && systemctl --user "${1}" "$(basename $0).service" || return 1
}

# Decide what to do.

case "${1}" in
  status)  handle_status              ;;
  start)   handle_start               ;;
  stop)    handle_stop                ;;
  restart) handle_restart             ;;
  systemd) shift; handle_systemd "$@" ;;
  *)       usage                      ;;
esac
