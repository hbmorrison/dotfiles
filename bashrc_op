function totp {
  local hostname="${1}"; shift
  if [ -z ${hostname:+z} ]
  then
    echo "Usage: $FUNCNAME <HOSTNAME>"
    return
  fi
  if [ -z ${OP_VAULT:+z} ]
  then
    op item get "${hostname}" --otp | clip.exe
  else
    op item get --vault "${OP_VAULT}" "${hostname}" --otp | clip.exe
  fi
}
