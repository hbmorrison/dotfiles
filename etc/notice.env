#!/bin/bash

# Pretty colours.

GOTO_COLUMN="\\033[72G"
RED='\033[00;31m'
GREEN='\033[00;32m'
YELLOW='\033[00;33m'
CLEAR='\033[00m'

# Indicate success or failure.

pass () {
  unset SETUP_QUESTION SETUP_VERB SETUP_NOUN
  echo -e "${GOTO_COLUMN}${GREEN}Done${CLEAR}"
}
fail () {
  echo -e "${GOTO_COLUMN}${YELLOW}Failed${CLEAR}"
  [ $# -eq 0 ] && [ -z ${SETUP_NOUN:+z} ] && return 1
  echo -ne "${YELLOW}Warning:"
  [ $# -eq 0 ] && echo -ne "${CLEAR}"
  [ ! -z ${SETUP_NOUN:+z} ] && echo -ne " could not ${SETUP_VERB} ${SETUP_NOUN}"
  [ $# -gt 0 ] && echo -e ":${CLEAR} $@"
  echo
  unset SETUP_QUESTION SETUP_VERB SETUP_NOUN
  return 1
}
fatal () {
  echo -e "${GOTO_COLUMN}${RED}Failed${CLEAR}"
  [ $# -eq 0 ] && [ -z ${SETUP_NOUN:+z} ] && exit 1
  echo -ne "${RED}Error:"
  [ $# -eq 0 ] && echo -ne "${CLEAR}"
  [ ! -z ${SETUP_NOUN:+z} ] && echo -ne " could not ${SETUP_VERB} ${SETUP_NOUN}"
  [ $# -gt 0 ] && echo -e ":${CLEAR} $@" || echo
  exit 1
}

# Answer a question.

respond_yes () {
  unset SETUP_QUESTION SETUP_VERB SETUP_NOUN
  echo -e "${GOTO_COLUMN}${GREEN}Yes${CLEAR}"
}
respond_no () {
  [ $# -eq 0 ] && echo -e "${GOTO_COLUMN}${YELLOW}No${CLEAR}" && return 1
  echo -e "${GOTO_COLUMN}${RED}No${CLEAR}"
  echo -ne "${RED}Error:"
  [ ! -z ${SETUP_QUESTION:+z} ] && echo -n " ${SETUP_QUESTION}:"
  echo -e "${CLEAR} $@"
  exit 1
}

# Issue usage error.

usage () {
  if [ ! -z ${1:+z} ]
  then
    echo -e "${YELLOW}Usage:${CLEAR} setup" "$@"
    exit 1
  fi
}

# Describe what the script is doing.

notice () {
  unset SETUP_QUESTION SETUP_VERB SETUP_NOUN
  echo -en "${1^} ... "
}

# Aliases for common notices.

notice_verb () {
  [ $# -lt 2 ] && fatal "not enough arguments given to notice_verb() function"
  SETUP_VERB="${1}"; shift
  SETUP_NOUN="$@"
  echo -en "${FUNCNAME[1]^} ${SETUP_NOUN} ... "
}

installing ()  { notice_verb "install" "$@"; }
extracting ()  { notice_verb "extract" "$@"; }
updating ()    { notice_verb "update" "$@"; }
upgrading ()   { notice_verb "upgrade" "$@"; }
starting ()    { notice_verb "start" "$@"; }
stopping ()    { notice_verb "stop" "$@"; }
restarting ()  { notice_verb "restart" "$@"; }
enabling ()    { notice_verb "enabling" "$@"; }
disabling ()   { notice_verb "disabling" "$@"; }
limiting ()    { notice_verb "limiting" "$@"; }
creating ()    { notice_verb "create" "$@"; }
adding ()      { notice_verb "add" "$@"; }
copying ()     { notice_verb "copy" "$@"; }
moving ()      { notice_verb "move" "$@"; }
removing ()    { notice_verb "remove" "$@"; }
replacing ()   { notice_verb "replace" "$@"; }
securing ()    { notice_verb "secure" "$@"; }
cloning ()     { notice_verb "clone" "$@"; }
pulling ()     { notice_verb "pull" "$@"; }
getting ()     { notice_verb "get" "$@"; }
setting ()     { notice_verb "set" "$@"; }
configuring () { notice_verb "configure" "$@"; }
sending ()     { notice_verb "send" "$@"; }

# Ask a question.

question () {
  [ $# -lt 2 ] && fatal "not enough arguments given to question() function"
  SETUP_VERB="${1}"; shift
  SETUP_QUESTION="${SETUP_VERB} $@"
  echo -n "${FUNCNAME[1]^} ${@} ... "
}

# Aliases for common questions.

checking() { question "check" "$@"; }

